# 🚀 BACKEND - DOCKER PRODUCTION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

NODE_ENV=production
PORT=4000
FRONTEND_URL=http://localhost:3000

# 🗄️ Database - Kết nối nội bộ Docker
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres123
DB_DATABASE=english_learning

# 🔐 Security
JWT_SECRET=my_ultra_secure_secret_123
JWT_EXPIRES_IN=24h

# 🎤 Speech Service
SPEECH_SERVICE_URL=http://speech-service:8000