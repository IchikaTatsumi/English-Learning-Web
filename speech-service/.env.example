# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ⚙️ APP CONFIG
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
ENV=production
HOST=0.0.0.0
PORT=8000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🎤 VOSK CONFIG (Chỉ tập trung STT)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Đảm bảo đường dẫn này khớp với volume mount trong docker-compose
VOSK_MODEL_PATH=speech_recognition/models/vosk-model-en-us-0.42-gigaspeech
VOSK_SAMPLE_RATE=16000