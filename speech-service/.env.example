# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ⚙️ APP CONFIG
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
ENV=production
HOST=0.0.0.0
PORT=8000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📦 MINIO STORAGE CONFIG
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 1. Endpoint nội bộ (để Python upload file)
# Dùng tên service 'minio' trong docker-compose
MINIO_ENDPOINT=minio:9000

# 2. Endpoint ngoại mạng (để Frontend play audio)
# Trả về localhost để trình duyệt truy cập được
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=english-learning-audio
MINIO_SECURE=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🎤 VOSK MODEL PATH
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Trỏ vào folder bạn đã giải nén (mount volume)
# Lưu ý: folder này nằm TRONG container, do docker-compose map vào
VOSK_MODEL_PATH=speech-recognition/models/vosk-model-en-us-0.42-gigaspeech