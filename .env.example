# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🌍 ROOT ENVIRONMENT VARIABLES (for docker-compose.yml)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 🗄️ Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=english_learning
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# 🔧 Backend Configuration
NODE_ENV=production
PORT=4000
FRONTEND_URL=http://localhost:3000

# 🔐 JWT Configuration
JWT_SECRET=my_ultra_secure_secret_123
JWT_EXPIRES_IN=24h

# 🎤 Speech Service
# Backend gọi tới container speech-service qua Docker Network
SPEECH_SERVICE_URL=http://speech-service:8000